---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="SC2Docs: StarCraft II Battle.net message formats, connection sequence, and native services."
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to SC2Docs</a>
    <slot />
  </body>
</html>
