---
/// One stable URL, overwritten by each release, so the page says nothing about
/// a version and never has to be rebuilt when one ships.
const RELEASES =
  (process.env.SUPERIORITY_RELEASE_BASE_URL ??
    "https://pub-ce8dea40e15e49cb9e8e01475b1876c0.r2.dev") + "/releases/";
const WINDOWS_DOWNLOAD =
  process.env.SUPERIORITY_WINDOWS_DOWNLOAD_URL ||
  `${RELEASES}Superiority-Windows.zip`;
---

<div class="download">
  <div class="platform">
    <a class="button primary" href={`${RELEASES}Superiority.dmg`} download
      >Download for macOS</a
    >
    <p class="detail">Universal · macOS 14+</p>
  </div>
  <div class="platform">
    <a class="button" href={WINDOWS_DOWNLOAD} download>
      Download for Windows
    </a>
    <p class="detail">64-bit · Windows 10+</p>
  </div>
</div>

<style>
  .download {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 14px;
  }

  .platform {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .button {
    display: inline-block;
    border: 1px solid rgba(51, 168, 240, 0.45);
    background: rgba(51, 168, 240, 0.05);
    padding: 14px 30px;
    font-family: var(--font-nav);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--blue-bright);
  }

  .button:hover {
    background: rgba(51, 168, 240, 0.14);
    color: var(--bright);
  }

  .button.primary {
    border-color: var(--blue);
    background: rgba(51, 168, 240, 0.12);
    color: var(--bright);
    box-shadow: 0 0 18px rgba(51, 168, 240, 0.25);
  }

  .button.primary:hover {
    background: rgba(51, 168, 240, 0.24);
  }

  .button:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }

  .detail {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--dim);
  }
</style>
