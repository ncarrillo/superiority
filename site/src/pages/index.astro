---
import { readdirSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { marked } from "marked";
import Download from "../components/Download.astro";
import "../styles/global.css";

const title = "Superiority";
const description =
  "A native Battle.net chat client for StarCraft II, StarCraft: Remastered, " +
  "and Warcraft III: Reforged. It signs in with your Battle.net account; the " +
  "game does not have to be running.";
const docsUrl =
  process.env.SC2DOCS_URL ?? "https://superiority-sc2docs.pages.dev/";

/// Every release since this one, newest first, rendered from the notes the
/// release itself shipped with. Nothing about them is written here — adding a
/// release adds a file to `release-notes/`, and `scripts/publish-update-macos.zsh` refuses to
/// publish without one, so this cannot fall behind the releases it lists.
///
/// Older entries describe an app that no longer works the way they say, which
/// is fair in a changelog and confusing on a front page.
const OLDEST_LISTED = "0.1.15";
const notes = fileURLToPath(new URL("../../../release-notes/", import.meta.url));

/** Sorted as numbers, so 0.1.9 comes before 0.1.10 rather than after it. */
function byVersion(left: string, right: string): number {
  const parts = (value: string) => value.split(".").map(Number);
  const [a, b] = [parts(left), parts(right)];
  for (let index = 0; index < Math.max(a.length, b.length); index += 1) {
    const difference = (b[index] ?? 0) - (a[index] ?? 0);
    if (difference !== 0) {
      return difference;
    }
  }
  return 0;
}

const releases = readdirSync(notes)
  .filter((name) => name.endsWith(".md"))
  .map((name) => name.replace(/\.md$/, ""))
  .filter((version) => byVersion(version, OLDEST_LISTED) <= 0)
  .sort(byVersion)
  .map((version) => ({
    version,
    // the notes open with their own "# Superiority x.y.z"; the version sits in
    // the margin here, so the file's copy would be a duplicate
    html: marked.parse(
      readFileSync(`${notes}${version}.md`, "utf8").replace(/^#\s.*\n/, ""),
    ),
  }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Superiority" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/superiority.png" />
    <link
      rel="preload"
      href="/ui/fonts/eurostileext-med.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/ui/fonts/eurostileext-reg.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/ui/fonts/eurostile-reg.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
  </head>
  <body>
    <header class="masthead">
      <div class="inner masthead-inner">
        <a class="wordmark" href="/">
          <span class="mark">
            <img src="/ui/img/adjutant.png" alt="" width="34" height="34" />
            <span class="tint"></span>
            <span class="vignette"></span>
          </span>
          <span class="name">Superiority</span>
        </a>
        <nav>
          <a href={docsUrl}>SC2Docs</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="scan"></div>
        <div class="inner hero-inner">
          <p class="eyebrow">Uplink established</p>
          <h1>A native Battle.net chat client</h1>
          <p class="games">
            StarCraft II · StarCraft: Remastered · Warcraft III: Reforged
          </p>
          <Download />
        </div>
      </section>

      <section class="history" id="releases">
        <div class="inner">
          {
            releases.map((release) => (
              <article>
                <h3 class="v">{release.version}</h3>
                <div class="notes" set:html={release.html} />
              </article>
            ))
          }
        </div>
      </section>

      <footer>
        <p class="disclaimer">
          Superiority · Not affiliated with Blizzard Entertainment
        </p>
      </footer>
    </main>

    <style>
      /* ---------- masthead ---------- */

      .masthead {
        border-bottom: 1px solid rgba(51, 168, 240, 0.25);
        background: linear-gradient(180deg, #0a101a, #070b12);
        box-shadow:
          0 1px 0 rgba(51, 168, 240, 0.12),
          0 6px 24px rgba(0, 0, 0, 0.5);
      }

      .masthead-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding-top: 18px;
        padding-bottom: 18px;
      }

      .wordmark {
        display: flex;
        align-items: center;
        gap: 14px;
        color: #e6edf7;
      }

      /* the adjutant, re-inked in CSS the same way the app's icon is baked */
      .mark {
        position: relative;
        width: 30px;
        height: 30px;
        overflow: hidden;
        background: #020810;
        flex-shrink: 0;
      }

      .mark img {
        position: absolute;
        left: -2px;
        top: -1px;
        width: 34px;
        height: 34px;
        object-fit: cover;
        filter: grayscale(1) contrast(1.6) brightness(1.35);
      }

      .mark .tint {
        position: absolute;
        inset: 0;
        background: var(--blue);
        mix-blend-mode: multiply;
      }

      .mark .vignette {
        position: absolute;
        inset: 0;
        background: radial-gradient(
          ellipse at 35% 40%,
          transparent 30%,
          rgba(2, 8, 16, 0.85) 90%
        );
      }

      .name {
        font-family: var(--font-nav);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 6px;
        text-transform: uppercase;
      }

      .masthead nav a {
        font-family: var(--font-nav);
        font-weight: 400;
        font-size: 11px;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--muted);
      }

      .masthead nav a:hover {
        color: var(--bright);
      }

      /* ---------- hero ---------- */

      .hero {
        position: relative;
        padding: 88px 0 84px;
        overflow: hidden;
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
          ellipse 60% 90% at 50% -10%,
          rgba(42, 127, 196, 0.22),
          transparent 70%
        );
      }

      .hero::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 2px;
        background: linear-gradient(
          90deg,
          transparent,
          #33a8f0 30%,
          #8fd4ff 50%,
          #33a8f0 70%,
          transparent
        );
        box-shadow: 0 0 24px rgba(51, 168, 240, 0.6);
      }

      .scan {
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(
          115deg,
          rgba(90, 170, 240, 0.05) 0px,
          rgba(90, 170, 240, 0.05) 1px,
          transparent 1px,
          transparent 7px
        );
        -webkit-mask-image: radial-gradient(
          ellipse 55% 90% at 50% 0%,
          black 15%,
          transparent 70%
        );
        mask-image: radial-gradient(
          ellipse 55% 90% at 50% 0%,
          black 15%,
          transparent 70%
        );
      }

      .hero-inner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 22px;
        text-align: center;
      }

      .eyebrow {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--slate);
      }

      .hero h1 {
        font-family: var(--font-nav);
        font-weight: 700;
        font-size: clamp(23px, 3.6vw, 34px);
        line-height: 1.15;
        letter-spacing: 2px;
        color: var(--bright);
        max-width: 900px;
        text-shadow: 0 0 40px rgba(51, 168, 240, 0.35);
        text-wrap: balance;
      }

      .games {
        font-size: 17px;
        color: var(--slate);
        max-width: 640px;
        line-height: 1.6;
        text-wrap: balance;
      }

      /* ---------- releases ---------- */

      .history {
        border-top: 1px solid var(--hairline);
        padding: 54px 0 80px;
      }

      article {
        display: flex;
        gap: 36px;
      }

      article + article {
        margin-top: 46px;
        padding-top: 46px;
        border-top: 1px solid rgba(51, 168, 240, 0.1);
      }

      .v {
        flex-shrink: 0;
        align-self: flex-start;
        border: 1px solid rgba(51, 168, 240, 0.35);
        background: rgba(51, 168, 240, 0.04);
        padding: 10px 18px;
        font-family: var(--font-mono);
        font-weight: 400;
        font-size: 14px;
        letter-spacing: 2px;
        color: var(--blue-bright);
      }

      /* the newest release is the one the download button installs */
      article:first-of-type .v {
        border-color: var(--blue);
        background: rgba(51, 168, 240, 0.08);
        color: var(--blue-glow);
        box-shadow: 0 0 14px rgba(51, 168, 240, 0.2);
      }

      article:hover .v {
        color: var(--blue-glow);
      }

      .notes {
        max-width: 820px;
        color: var(--soft);
      }

      .notes > :global(p:first-child) {
        font-size: 17px;
        color: var(--ink);
        margin-bottom: 26px;
      }

      /* The notes are written as headed lists; this is the whole vocabulary
         they use. */
      .notes :global(h2) {
        font-family: var(--font-nav);
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--blue-bright);
        margin: 26px 0 10px;
      }

      .notes :global(h2:first-child) {
        margin-top: 0;
      }

      .notes :global(p) {
        margin: 0 0 14px;
      }

      .notes :global(ul) {
        display: grid;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
        font-size: 14.5px;
        line-height: 1.6;
      }

      .notes :global(li) {
        position: relative;
        padding-left: 16px;
      }

      .notes :global(li)::before {
        content: "·";
        position: absolute;
        left: 2px;
      }

      .notes :global(code) {
        font-family: var(--font-mono);
        font-size: 0.92em;
        color: var(--blue-bright);
      }

      /* ---------- footer ---------- */

      footer {
        display: flex;
        justify-content: center;
        border-top: 1px solid rgba(51, 168, 240, 0.12);
        padding: 26px 24px;
      }

      .disclaimer {
        font-family: var(--font-mono);
        font-size: 10px;
        letter-spacing: 2px;
        text-transform: uppercase;
        text-align: center;
        color: var(--faint);
      }

      /* ---------- responsive ---------- */

      @media (max-width: 760px) {
        .hero {
          padding: 64px 0 60px;
        }

        article {
          flex-direction: column;
          gap: 16px;
        }

        article + article {
          margin-top: 38px;
          padding-top: 38px;
        }

        .v {
          align-self: flex-start;
        }
      }
    </style>
  </body>
</html>
