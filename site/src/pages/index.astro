---
import { readdirSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { marked } from "marked";
import Download from "../components/Download.astro";
import "../styles/global.css";

const title = "Superiority";
const description =
  "A native Battle.net chat client for StarCraft II. It signs in with your " +
  "Battle.net account; the game does not have to be running.";

/// Every release since this one, newest first, rendered from the notes the
/// release itself shipped with. Nothing about them is written here — adding a
/// release adds a file to `release-notes/`, and `scripts/publish-update-macos.zsh` refuses to
/// publish without one, so this cannot fall behind the releases it lists.
///
/// Older entries describe an app that no longer works the way they say, which
/// is fair in a changelog and confusing on a front page.
const OLDEST_LISTED = "0.1.15";
const notes = fileURLToPath(new URL("../../../release-notes/", import.meta.url));

/** Sorted as numbers, so 0.1.9 comes before 0.1.10 rather than after it. */
function byVersion(left: string, right: string): number {
  const parts = (value: string) => value.split(".").map(Number);
  const [a, b] = [parts(left), parts(right)];
  for (let index = 0; index < Math.max(a.length, b.length); index += 1) {
    const difference = (b[index] ?? 0) - (a[index] ?? 0);
    if (difference !== 0) {
      return difference;
    }
  }
  return 0;
}

const releases = readdirSync(notes)
  .filter((name) => name.endsWith(".md"))
  .map((name) => name.replace(/\.md$/, ""))
  .filter((version) => byVersion(version, OLDEST_LISTED) <= 0)
  .sort(byVersion)
  .map((version) => ({
    version,
    // the notes open with their own "# Superiority x.y.z"; the version sits in
    // the margin here, so the file's copy would be a duplicate
    html: marked.parse(
      readFileSync(`${notes}${version}.md`, "utf8").replace(/^#\s.*\n/, ""),
    ),
  }));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Superiority" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/superiority.png" />
    <link
      rel="preload"
      href="/ui/fonts/eurostile-bol.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/ui/fonts/eurostileext-med.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <link
      rel="preload"
      href="/ui/fonts/eurostile-reg.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
  </head>
  <body>
    <header class="masthead">
      <div class="masthead-inner">
        <a class="wordmark" href="/">
          <img src="/superiority.png" alt="" width="26" height="26" />
          <span>Superiority</span>
        </a>
        <nav>
          <a href="/PROTOCOL.html">Protocol</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <h1>A native Battle.net chat client for StarCraft&nbsp;II.</h1>
        <Download />
      </section>

      <section class="history" id="releases">
        {
          releases.map((release) => (
            <article>
              <h3 class="v">{release.version}</h3>
              <div class="notes" set:html={release.html} />
            </article>
          ))
        }
      </section>

      <footer>
        <p class="disclaimer">
          Superiority is an independent project. It is not affiliated with,
          endorsed by, or sponsored by Blizzard Entertainment. StarCraft and
          Battle.net are trademarks of Blizzard Entertainment, Inc.
        </p>
      </footer>
    </main>

    <style>
      /* ---------- masthead ---------- */

      .masthead {
        position: relative;
        background:
          url("/ui/img/top-nav-background.png") repeat-x top / auto 100%,
          #0c1826;
      }

      /* the app's own selected-line and glow strips, stretched across the bar */
      .masthead::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -7px;
        height: 14px;
        background:
          url("/ui/img/top-nav-selected-line.png") no-repeat center / 100% 100%,
          url("/ui/img/top-nav-selected-line-glow.png") no-repeat center / 100%
            100%;
        pointer-events: none;
      }

      .masthead-inner {
        max-width: 1000px;
        margin: 0 auto;
        padding: 0 24px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .wordmark {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        font-family: var(--font-nav);
        font-weight: 500;
        font-size: 13px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .wordmark img {
        display: block;
        /* the icon carries its own glow in the app; this is the same idea */
        filter: drop-shadow(0 3px 12px rgba(51, 168, 240, 0.35));
      }

      .masthead nav {
        display: flex;
        gap: 26px;
      }

      .masthead nav a {
        font-family: var(--font-nav);
        font-weight: 500;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
        text-decoration: none;
      }

      .masthead nav a:hover {
        color: var(--header-blue);
        text-shadow: 0 0 12px
          color-mix(in srgb, var(--header-blue) 50%, transparent);
      }

      /* ---------- hero ---------- */

      .hero {
        position: relative;
        display: grid;
        gap: 22px;
        justify-items: start;
        padding: 76px 0 0;
      }

      /* the title band the app draws behind its modal headers */
      .hero::before {
        content: "";
        position: absolute;
        top: 30px;
        left: -55%;
        width: 165%;
        height: 195px;
        background: url("/ui/img/modal-title-band.png") no-repeat center / 100%
          100%;
        opacity: 0.6;
        pointer-events: none;
      }

      /* the nav wordmark carries the name; the hero states what the thing
         is, in the app's header treatment from updater.rs */
      .hero h1 {
        font-family: var(--font-head);
        font-weight: 700;
        font-size: clamp(24px, 3.4vw, 34px);
        line-height: 1.25;
        letter-spacing: 0.02em;
        text-wrap: balance;
        color: var(--header-blue);
        text-shadow: 0 0 26px
          color-mix(in srgb, var(--header-blue) 35%, transparent);
      }

      /* ---------- releases ---------- */

      .history {
        margin-top: 84px;
      }

      article {
        display: grid;
        grid-template-columns: 88px 1fr;
        gap: 28px;
        padding: 28px 0;
        border-top: 1px solid var(--hairline);
      }

      /* versions as the app's segmented-tab chips; the newest one is lit */
      .v {
        justify-self: start;
        align-self: start;
        margin-top: -6px;
        border: 11px solid transparent;
        border-image: url("/ui/img/segmented-tab-idle.png") 30 fill / 11px
          stretch;
        padding: 1px 7px 0;
        min-width: 42px;
        text-align: center;
        font-family: var(--font-nav);
        font-size: 11.5px;
        font-weight: 500;
        letter-spacing: 0.1em;
        color: #9fb3cc;
      }

      article:first-of-type .v {
        border-image-source: url("/ui/img/segmented-tab-active.png");
        color: #d9f1ff;
        text-shadow: 0 0 10px rgba(98, 201, 255, 0.5);
      }

      article:hover .v {
        color: #d9f1ff;
      }

      .notes {
        max-width: 64ch;
        font-size: 15px;
        color: var(--soft);
      }

      .notes > :global(p:first-child) {
        font-size: 15.5px;
        color: var(--ink);
        margin-bottom: 14px;
      }

      /* The notes are written as headed lists; this is the whole vocabulary
         they use. */
      .notes :global(h2) {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--ink);
        margin: 24px 0 10px;
      }

      .notes :global(h2:first-child) {
        margin-top: 0;
      }

      .notes :global(p) {
        margin: 0 0 14px;
      }

      .notes :global(ul) {
        display: grid;
        gap: 7px;
        margin: 0;
        padding-left: 19px;
        font-size: 14.5px;
      }

      .notes :global(li)::marker {
        color: color-mix(in srgb, var(--blue) 70%, transparent);
      }

      .notes :global(code) {
        font-size: 0.92em;
        color: var(--blue-bright);
      }

      /* ---------- footer ---------- */

      footer {
        margin-top: 72px;
        padding-top: 24px;
        border-top: 1px solid var(--hairline);
      }

      .disclaimer {
        font-size: 12.5px;
        color: var(--muted);
        max-width: 82ch;
      }

      /* ---------- responsive ---------- */

      @media (max-width: 760px) {
        .hero {
          padding-top: 52px;
        }

        article {
          grid-template-columns: 1fr;
          gap: 12px;
        }
      }
    </style>
  </body>
</html>
