<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Stimpak</RootNamespace>
    <AssemblyName>Stimpak</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Stimpak</PackageId>
    <Version>0.1.0</Version>
    <Authors>Nicholas Carrillo</Authors>
    <Description>StarCraft II Battle.net bot client with a native Rust core and typed .NET events.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ncarrillo/superiority</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>starcraft;starcraft2;battlenet;bot;chat</PackageTags>
  </PropertyGroup>

  <!--
    the managed assembly is useless without the native library beside it, so the
    build copies it rather than leaving that to a DYLD_LIBRARY_PATH the caller
    has to remember. point StimpakNativeDir at a prebuilt library to consume
    one without a rust toolchain.
  -->
  <PropertyGroup>
    <!-- release only: the native side is a dependency, not something a managed
         Debug build should be recompiling unoptimised. -->
    <StimpakNativeDir Condition="'$(StimpakNativeDir)' == ''">$(MSBuildThisFileDirectory)../../../target/release/</StimpakNativeDir>
    <!-- false to consume a prebuilt library instead of invoking cargo. -->
    <StimpakBuildNative Condition="'$(StimpakBuildNative)' == ''">true</StimpakBuildNative>
  </PropertyGroup>

  <Target Name="BuildStimpakNative"
          BeforeTargets="ResolveStimpakNative"
          Condition="'$(StimpakBuildNative)' == 'true'">
    <Exec Command="cargo build --release -p stimpak"
          WorkingDirectory="$(MSBuildThisFileDirectory)../../../" />
  </Target>

  <Target Name="ResolveStimpakNative" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- globs, not literal paths: a wildcard matches only files that exist,
           so a platform's missing variants never become items. -->
      <StimpakNativeLibrary Include="$(StimpakNativeDir)*libstimpak.dylib;
                                         $(StimpakNativeDir)*libstimpak.so;
                                         $(StimpakNativeDir)*stimpak.dll" />
      <!-- None with CopyToOutputDirectory flows to referencing projects, so an
           app that only references this library still gets the native one. -->
      <None Include="@(StimpakNativeLibrary)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
    <Warning Condition="'@(StimpakNativeLibrary)' == ''"
             Code="SUP001"
             Text="No native library found in $(StimpakNativeDir). Run 'cargo build --release -p stimpak' from the repository root, or set StimpakNativeDir to a directory that already holds one." />
  </Target>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../include/stimpak.h" Pack="true" PackagePath="build/native/include/" />
    <None Include="buildTransitive/Stimpak.targets"
          Pack="true"
          PackagePath="buildTransitive/Stimpak.targets" />
    <StimpakPackageNative Include="$(MSBuildThisFileDirectory)../artifacts/runtimes/**/*" />
    <None Include="@(StimpakPackageNative)"
          Pack="true"
          PackagePath="runtimes/" />
  </ItemGroup>

  <Target Name="ValidateStimpakPackage" BeforeTargets="Pack">
    <Error Condition="'@(StimpakPackageNative)' == ''"
           Text="No staged native runtimes found under stimpak/csharp/artifacts/runtimes. See stimpak/README.md." />
  </Target>

  <Import Project="buildTransitive/Stimpak.targets" />
</Project>
